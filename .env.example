# Copy this file to .env.local and fill in your own values.
# See the setup guide in the project README / CLAUDE.md for where to get each key.

# --- Convex ---
# Run `npx convex dev` once — it creates your own Convex project and writes
# NEXT_PUBLIC_CONVEX_URL into .env.local automatically.
NEXT_PUBLIC_CONVEX_URL=

# --- Clerk (auth) ---
# dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk -> Configure -> JWT Templates -> new template named exactly "convex"
# -> copy the "Issuer" URL. Also set this same value as CLERK_JWT_ISSUER_DOMAIN
# in your Convex deployment's environment variables (Convex dashboard ->
# Settings -> Environment Variables), not just here.
CLERK_JWT_ISSUER_DOMAIN=

# --- Google AI Studio (Gemini) ---
# Free API key for AI post generation and comment classification.
# aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Meta (Facebook Pages + Instagram) ---
# developers.facebook.com -> My Apps -> Create App (type: Business)
# Add products: Facebook Login, Instagram Graph API.
# App Settings -> Basic -> App ID / App Secret.
# You'll also need a Facebook Page you admin, with an Instagram
# Business/Creator account linked to it, to actually connect an account.
META_APP_ID=
META_APP_SECRET=

# --- Resend (real outreach email sending) ---
# resend.com -> API Keys. Read by convex/outreach.ts, so this must be set
# in your Convex deployment's environment variables (Convex dashboard ->
# Settings -> Environment Variables, or `npx convex env set RESEND_API_KEY
# ...`), not just here — putting it only in .env.local won't reach it.
# Until you verify your own sending domain in Resend, their sandbox sender
# (the default below) can only deliver to the email address on your Resend
# account — real prospects won't receive it until a domain is verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
